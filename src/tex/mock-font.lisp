(defun maphash-ish (table font)
  (dolist (e table)
    (math-font-set-char font (nth 0 e) (nth 1 e) (nth 2 e) (nth 3 e) (nth 4 e))))

(defun install-params (font table)
  (dolist (e table)
    (setf (math-font-param font (car e)) (cdr e))))

(defun make-cm-font (family name size table params)
  (let ((font (make-math-font :family family :name name
                              :size size :design-size size)))
    (install-params font params)
    (maphash-ish table font)
    font))

(defparameter *cm-text-size*  655360)
(defparameter *cm-script-size* 458752)
(defparameter *cm-ss-size*    327680)

(defun make-cmr-font (family size-code)
  (ecase size-code
    (0 (make-cm-font family "cmr" *cm-text-size*   *cmr-chars*  *cmr-params-0*))
    (1 (make-cm-font family "cmr" *cm-script-size* *cmr7-chars* *cmr-params-1*))
    (2 (make-cm-font family "cmr" *cm-ss-size*     *cmr5-chars* *cmr-params-2*))))

(defun make-cmmi-font (family size-code)
  (ecase size-code
    (0 (make-cm-font family "cmmi" *cm-text-size*   *cmmi-chars*  *cmr-params-0*))
    (1 (make-cm-font family "cmmi" *cm-script-size* *cmmi7-chars* *cmr-params-1*))
    (2 (make-cm-font family "cmmi" *cm-ss-size*     *cmmi5-chars* *cmr-params-2*))))

(defun make-cmsy-font (family size-code)
  (ecase size-code
    (0 (make-cm-font family "cmsy" *cm-text-size*   *cmsy-chars*  *cmsy-params-0*))
    (1 (make-cm-font family "cmsy" *cm-script-size* *cmsy7-chars* *cmsy-params-1*))
    (2 (make-cm-font family "cmsy" *cm-ss-size*     *cmsy5-chars* *cmsy-params-2*))))

(defun make-cmex-font (family &optional size-code)
  ;; plain TeX：\scriptfont3=\textfont3=cmex10（fam3 三个尺寸都是 cmex10）。
  (declare (ignore size-code))
  (let ((font (make-cm-font family "cmex" *cm-text-size* nil *cmex-params*)))
    ;; 真实 cmex10 度量：0/1 = \big( / \big)（w=300375 h=26213 d=760226）。
    (math-font-set-char font 0 300375 26213 760226 0)
    (math-font-set-char font 1 300375 26213 760226 0)
    ;; 大算子（真实 cmex10 度量）：80–87 text 变体 → 88–95 display 变体
    ;; （next-larger 链，display 风格 make_op 沿链取大号，tex.web L14688–14693）。
    (math-font-set-char font 80 691771 0 655368 0)
    (math-font-set-char font 81 618953 0 655368 0)
    (math-font-set-char font 82 309476 0 728185 127431)
    (math-font-set-char font 83 546135 0 655368 0)
    (math-font-set-char font 84 546135 0 655368 0)
    (math-font-set-char font 85 546135 0 655368 0)
    (math-font-set-char font 86 546135 0 655368 0)
    (math-font-set-char font 87 546135 0 655368 0)
    (math-font-set-char font 88 946633 65536 983048 0)
    (math-font-set-char font 89 837406 65536 983048 0)
    (math-font-set-char font 90 364090 0 1456371 291271)
    (math-font-set-char font 91 728180 65536 983048 0)
    (math-font-set-char font 92 728180 65536 983048 0)
    (math-font-set-char font 93 728180 65536 983048 0)
    (math-font-set-char font 94 728180 65536 983048 0)
    (math-font-set-char font 95 728180 65536 983048 0)
    (math-font-set-larger-variant font 80 88)
    (math-font-set-larger-variant font 81 89)
    (math-font-set-larger-variant font 82 90)
    (math-font-set-larger-variant font 83 91)
    (math-font-set-larger-variant font 84 92)
    (math-font-set-larger-variant font 85 93)
    (math-font-set-larger-variant font 86 94)
    (math-font-set-larger-variant font 87 95)
    ;; 可打印预览别名：40/41='('/')'（0/1 的度量，code 0/1 是控制字符）、
    ;; 8721='∑'（display ∑ 88 的度量）。
    (math-font-set-char font 40 300375 26213 760226 0)
    (math-font-set-char font 41 300375 26213 760226 0)
    (math-font-set-char font 8721 946633 65536 983048 0)
    ;; 括号变体链（真实 cmex10）：0→16→18（左括号）、1→17→19（右括号）。
    ;; \left( 的 delcode 是 small=fam0'(' / large=fam3 char 0，目标高不够时
    ;; 沿链放大（var_delimiter，tex.web L13952–13971）。
    (math-font-set-char font 16 391396 26213 1153446 0)
    (math-font-set-char font 17 391396 26213 1153446 0)
    (math-font-set-char font 18 482420 26213 1546666 0)
    (math-font-set-char font 19 482420 26213 1546666 0)
    (math-font-set-larger-variant font 0 16)
    (math-font-set-larger-variant font 16 18)
    (math-font-set-larger-variant font 1 17)
    (math-font-set-larger-variant font 17 19)
    ;; 根号变体链（真实 cmex10 度量）：112–115 整体变体（next-larger 链），
    ;; 116 起可扩展（VARCHAR top=118、bot=116、rep=117，无 mid）。
    (math-font-set-char font 112 655361 26213 760226 0)
    (math-font-set-char font 113 655361 26213 1153446 0)
    (math-font-set-char font 114 655361 26213 1546666 0)
    (math-font-set-char font 115 655361 26213 1939886 0)
    (math-font-set-char font 116 691771 0 1179660 0)
    (math-font-set-char font 117 691771 0 393220 0)
    (math-font-set-char font 118 691771 26213 367006 0)
    (math-font-set-larger-variant font 112 113)
    (math-font-set-larger-variant font 113 114)
    (math-font-set-larger-variant font 114 115)
    (math-font-set-larger-variant font 115 116)
    (math-font-set-extensible-parts font 116 118 0 116 117)
    font))

;;; Compatibility aliases removed (Phase 9): the real factories make-cmr-font
;;; / make-cmmi-font / make-cmsy-font / make-cmex-font are exported directly.

(defun copy-math-pars (dest src)
  "Merge SRC's math parameters (fontdimens) into DEST."
  (maphash (lambda (k v) (setf (gethash k (math-font-params dest)) v))
           (math-font-params src))
  dest)

(defun make-default-fonts ()
  "16 槽位字体向量：index = family + 4×size-code（0–3 text / 4–7 script /
8–11 scriptscript）。math-font-for 按此选取；槽位 2（cmsy10）仍是
「math 主字体」的兼容入口。"
  (let ((fonts (make-array 16 :initial-element nil)))
    (setf (aref fonts 0) (make-cmr-font 0 0)
          (aref fonts 1) (make-cmmi-font 1 0)
          (aref fonts 2) (make-cmsy-font 2 0)
          (aref fonts 3) (make-cmex-font 3 0)
          (aref fonts 4) (make-cmr-font 0 1)
          (aref fonts 5) (make-cmmi-font 1 1)
          (aref fonts 6) (make-cmsy-font 2 1)
          (aref fonts 7) (make-cmex-font 3 1)
          (aref fonts 8) (make-cmr-font 0 2)
          (aref fonts 9) (make-cmmi-font 1 2)
          (aref fonts 10) (make-cmsy-font 2 2)
          (aref fonts 11) (make-cmex-font 3 2))
    ;; Point every script/scriptscript font at its family's text-size font so
    ;; the renderer can compensate for Latin Modern Math having one design.
    (dotimes (i 16)
      (when (aref fonts i)
        (setf (math-font-ten-point (aref fonts i))
              (aref fonts (mod i 4)))))
    (copy-math-pars (aref fonts 2) (aref fonts 3))
    fonts))
